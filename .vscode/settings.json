{
  "editor.formatOnSave": true,

  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "files.associations": {
    "*.heps.yaml": "yaml",
    "*.heps.yml": "yaml"
  },

  "yaml.validate": true,

  "explorer.compactFolders": false
}
